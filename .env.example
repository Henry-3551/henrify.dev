# Resend API key
RESEND_API_KEY=your_resend_api_key

# Where to send contact emails
TO_EMAIL=henrifydev@gmail.com

# Required: must be a verified sender in Resend
FROM_EMAIL=hello@yourdomain.com

# Optional: comma-separated CORS allowlist for production/dev frontend domains
ALLOWED_ORIGINS=https://henrify.dev,https://www.henrify.dev,http://localhost:5500,http://127.0.0.1:5500
