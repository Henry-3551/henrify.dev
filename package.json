{
  "name": "henrify-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm run build:css",
    "build:css": "npx tailwindcss -i CSS/tailwind.css -o CSS/tailwind-output.css --minify",
    "watch:css": "npx tailwindcss -i CSS/tailwind.css -o CSS/tailwind-output.css --watch",
    "start": "node server.js"
  },
  "dependencies": {
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "nodemailer": "^8.0.4",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3"
  }
}
