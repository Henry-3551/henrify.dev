{
  "name": "henrify-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Portfolio site with a Resend-backed contact form and resume PDF generation.",
  "main": "server.js",
  "scripts": {
    "build": "npm run build:css",
    "build:css": "node ./node_modules/tailwindcss/lib/cli.js -i CSS/tailwind.css -o CSS/tailwind-output.css --minify",
    "watch:css": "node ./node_modules/tailwindcss/lib/cli.js -i CSS/tailwind.css -o CSS/tailwind-output.css --watch",
    "start": "node server.js",
    "generate-pdf": "node scripts/generate-pdf.js"
  },
  "author": "Henry Ani",
  "license": "MIT",
  "dependencies": {
    "autoprefixer": "^10.4.20",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "postcss": "^8.4.38",
    "puppeteer": "^21.0.0",
    "resend": "^4.6.0",
    "tailwindcss": "^3.4.3"
  }
}
